{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python -m py_compile:*)",
      "Bash(uvicorn peskas_api.main:app*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "extraKnownMarketplaces": {
    "peskas": {
      "source": {
        "source": "github",
        "repo": "WorldFishCenter/peskas-context"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "peskas@peskas": true,
    "ponytail@ponytail": true
  }
}
